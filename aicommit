#!/bin/bash
base_url="${LLM_BASE_URL:-http://localhost:1234/v1}"
auth_key="${LLM_AUTH_KEY:-}"
model="${LLM_MODEL:-gpt-3.5-turbo}"

set -f

MAXSIZE=5000
MAXTIME=300
API=${LLM_API:-response_stream}
EFFORT=low

status_output="$(git status --short)"

sorted_files=$(git diff --cached --numstat | awk '{print $1+$2, $3}' | sort -n | cut -d' ' -f2-)

diff_output=""
while IFS= read -r file; do
	[ -z "$file" ] && continue

	# 检查添加此文件是否会超限
	file_diff=$(git diff --cached -- "$file")
	current_len=${#diff_output}
	new_len=$((current_len + ${#file_diff}))

	if [ $new_len -gt $MAXSIZE ]; then
		echo -e "\033[93mWarning: diff truncated to $MAXSIZE bytes (reached limit while adding files)\033[0m"
		break
	fi

	diff_output+="$file_diff"$'\n'
done <<<"$sorted_files"

if [ -z "$diff_output" ]; then
	echo "No changes to commit"
	exit 1
fi

# 二次截断兜底（无警告）
if [ "$(echo "$diff_output" | wc -c)" -gt $MAXSIZE ]; then
	diff_output=$(echo "$diff_output" | head -c $MAXSIZE)
fi

system_prompt="
根据以下 git status 和 git diff 输出，使用 Conventional Commits 规范生成 commit message。

格式: <type>[optional scope]: <description>

[optional body]

[optional footer(s)]

要求:
1. type 为必选，scope 可选。type/scope/BREAKING CHANGE/Closes/Refs 等关键词用英文，description/body/footer 用中文
2. type 可选值: feat(新功能), fix(修复), docs(文档), style(格式), refactor(重构), perf(性能), test(测试), build(构建), ci(CI), chore(维护), revert(回滚)
3. description 用中文祈使句，不超过72字符（如\"添加搜索功能\"而非\"添加了搜索功能\"）
4. 如有需要，空行后添加 body，可用列表总结修改点
5. BREAKING CHANGE 在 type/scope 后加 !，或在 footer 中用 BREAKING CHANGE: 说明
6. 移除删除线、加粗和内联代码、代码块等格式符号，直接输出文本。
"

user_prompt="
status:
\`\`\`
${status_output}
\`\`\`

diff:
\`\`\`
${diff_output}
\`\`\`
"

echo "=== LLM Configuration ==="
echo "Base URL: $base_url"
echo "Model: $model"
if [ -n "$auth_key" ]; then
	echo "API Key: ${auth_key:0:10}..." # Show only first 10 chars for security
else
	echo "API Key: (not set)"
fi
echo "API: $API"
echo "========================="
echo ""

echo Generating...
commit_message=""
case "$API" in
response_stream)
	payload=$(jq -n -c \
		--arg model "$model" \
		--arg inst "$system_prompt" \
		--arg prompt "$user_prompt" \
		--arg effort "$EFFORT" \
		'{model: $model, instructions: $inst, input: [{role: "user", content: $prompt}],
	reasoning: {effort: $effort},store:false,temperature:0,stream:true}')
	# echo payload "$payload"
	thinking=0
	while IFS= read -r line; do
		# echo "$line"
		case "$line" in
		event:*)
			# 提取事件类型，去除 prefix 和前后空白
			current_event="${line#event:}"
			current_event="${current_event#"${current_event%%[![:space:]]*}"}"
			;;
		data:*)
			# 提取数据内容，去除 prefix 和前后空白
			data_line="${line#data:}"
			data_line="${data_line#"${data_line%%[![:space:]]*}"}"
			# 累加 data 行（支持多行 data，用换行符连接）
			if [ -z "$data_accumulator" ]; then
				data_accumulator="$data_line"
			else
				data_accumulator="${data_accumulator}\n${data_line}"
			fi
			;;
		"")
			# 遇到空行表示一个事件结束
			if [ -n "$data_accumulator" ]; then
				event_name="${current_event}" # 默认事件名为 "message"
				# 根据 event 类型处理 JSON 字符串（$data_accumulator）
				case "$event_name" in
				response.reasoning_text.delta | response.reasoning_summary_text.delta)
					if [[ $thinking -eq 0 ]]; then
						thinking=1
						echo -e "\033[90m"
					fi
					echo "$data_accumulator" | jq -rj '.delta'
					;;
				response.output_text.delta)
					if [[ $thinking -eq 1 ]]; then
						thinking=0
						echo -e "\033[0m"
					fi
					echo "$data_accumulator" | jq -rj '.delta'
					;;
				response.output_text.done)
					commit_message="$(
						echo "$data_accumulator" | jq -rj '.text'
					)"
					;;
				error)
					echo -e "\033[31merror: $data_accumulator\033[0m"
					exit 1
					;;
				response.created | \
					response.in_progress | \
					response.output_item.added | \
					response.content_part.added | \
					response.content_part.done | \
					response.output_item.done | \
					response.reasoning_text.done | \
					response.completed | \
					response.reasoning_summary_text.done)
					;;
				*)
					# echo "未处理的事件（$event_name）"
					# echo "$data_accumulator"
					# echo
					;;
				esac
				# 重置当前事件状态
				current_event=""
				data_accumulator=""
			fi
			;;
		*)
			# 忽略 id:、retry: 等其他 SSE 字段
			;;
		esac
	done < <(curl -s -N --max-time $MAXTIME "${base_url%/}/responses" \
		-H "Content-Type: application/json" \
		-H "Authorization: Bearer $auth_key" \
		-d "$payload")
	;;
chat_stream)
	payload=$(jq -n -c \
		--arg model "$model" \
		--arg sys "$system_prompt" \
		--arg prompt "$user_prompt" \
		'{model: $model, messages: [{role: "system", content: $sys}, {role: "user", content: $prompt}], temperature: 0, stream: true}')

	thinking=0
	while IFS= read -r line; do
		case "$line" in
		data:*)
			data_line="${line#data:}"
			data_line="${data_line#"${data_line%%[![:space:]]*}"}"
			[ "$data_line" = "[DONE]" ] && break

			r=$(
				echo "$data_line" | jq -rj '.choices[0].delta.reasoning_content // empty' 2>/dev/null
				printf '\001e'
			)
			r="${r%$'\001e'}"
			c=$(
				echo "$data_line" | jq -rj '.choices[0].delta.content // empty' 2>/dev/null
				printf '\001e'
			)
			c="${c%$'\001e'}"

			if [ -n "$r" ]; then
				[ $thinking -eq 0 ] && thinking=1 && echo -ne "\033[90m"
				echo -n "$r"
			fi
			if [ -n "$c" ]; then
				[ $thinking -eq 1 ] && thinking=0 && echo -e "\033[0m"
				commit_message+="$c"
				echo -n "$c"
			fi
			;;
		esac
	done < <(curl -s -N --max-time $MAXTIME "${base_url%/}/chat/completions" \
		-H "Content-Type: application/json" \
		-H "Authorization: Bearer $auth_key" \
		-d "$payload")

	if [ $thinking -eq 1 ]; then
		echo -ne "\033[0m"
	fi
	;;
*)
	;;
esac

echo
echo
git commit -m "$commit_message"
